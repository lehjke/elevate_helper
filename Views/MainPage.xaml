<?xml version="1.0" encoding="UTF-8"?>
<Page
    x:Class="ElevateHelperWinUI.Views.MainPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="OnRunKeyboardAcceleratorInvoked" />
        <KeyboardAccelerator Key="S" Modifiers="Control,Shift" Invoked="OnStopAllKeyboardAcceleratorInvoked" />
    </Page.KeyboardAccelerators>

    <Grid
        Padding="20"
        Background="{ThemeResource IosPageBackgroundBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveLayoutStates">
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MainContentScrollViewer.VerticalScrollMode" Value="Auto" />
                        <Setter Target="MainContentScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                        <Setter Target="MainContentGrid.ColumnSpacing" Value="0" />
                        <Setter Target="MainContentGrid.RowSpacing" Value="16" />
                        <Setter Target="MainContentFirstRow.Height" Value="Auto" />
                        <Setter Target="MainContentSecondRow.Height" Value="Auto" />
                        <Setter Target="RightColumnDefinition.Width" Value="0" />
                        <Setter Target="QueueCard.(Grid.Column)" Value="0" />
                        <Setter Target="QueueCard.(Grid.Row)" Value="1" />
                        <Setter Target="ToolbarLanguageColumn.Width" Value="132" />
                        <Setter Target="ToolbarSecondRow.Height" Value="Auto" />
                        <Setter Target="ToolbarGrid.RowSpacing" Value="10" />
                        <Setter Target="LanguageLabelTextBlock.Visibility" Value="Collapsed" />
                        <Setter Target="HideElevateWindowsLabelTextBlock.Visibility" Value="Collapsed" />
                        <Setter Target="LanguageFlyoutButton.(Grid.Row)" Value="1" />
                        <Setter Target="LanguageFlyoutButton.(Grid.Column)" Value="0" />
                        <Setter Target="LanguageFlyoutButton.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="LanguageFlyoutButton.Width" Value="132" />
                        <Setter Target="LanguageFlyoutButton.HorizontalAlignment" Value="Left" />
                        <Setter Target="HideElevateWindowsStackPanel.(Grid.Row)" Value="1" />
                        <Setter Target="HideElevateWindowsStackPanel.(Grid.Column)" Value="3" />
                        <Setter Target="HideElevateWindowsStackPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="HideElevateWindowsStackPanel.HorizontalAlignment" Value="Right" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="960" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid
            MaxWidth="1040"
            HorizontalAlignment="Stretch"
            RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Style="{StaticResource ToolbarCardStyle}">
                    <Grid
                        x:Name="ToolbarGrid"
                        MinHeight="38"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition x:Name="ToolbarLanguageColumn" Width="170" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="ToolbarSecondRow" Height="0" />
                        </Grid.RowDefinitions>

                        <Image
                            Grid.Column="0"
                            Width="28"
                            Height="28"
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            Source="ms-appx:///Assets/AppIcon.png" />

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.HeadingLevel="Level1"
                                FontSize="19"
                                FontWeight="SemiBold"
                                Text="{x:Bind Text.AppTitle, Mode=OneTime}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource IosSubtleTextBrush}"
                                Text="{x:Bind AppVersionLabel, Mode=OneTime}" />
                        </StackPanel>

                        <TextBlock
                            x:Name="LanguageLabelTextBlock"
                            Grid.Column="2"
                            Style="{StaticResource ToolbarLabelStyle}"
                            Text="{x:Bind Text.LanguageLabel, Mode=OneTime}" />

                        <Button
                            x:Name="LanguageFlyoutButton"
                            Grid.Column="3"
                            AccessKey="G"
                            Style="{StaticResource ToolbarLanguageButtonStyle}">
                            <Button.Flyout>
                                <Flyout
                                    x:Name="LanguageFlyout"
                                    FlyoutPresenterStyle="{StaticResource LanguageFlyoutPresenterStyle}"
                                    Placement="Bottom">
                                    <StackPanel MinWidth="158" Spacing="2">
                                        <Button
                                            x:Name="EnglishLanguageButton"
                                            Click="OnLanguageFlyoutOptionClick"
                                            Style="{StaticResource LanguageFlyoutItemButtonStyle}">
                                            <Grid MinHeight="36">
                                                <Border
                                                    x:Name="EnglishLanguageSelectionBackground"
                                                    Background="{ThemeResource IosAccentSoftBrush}"
                                                    CornerRadius="8"
                                                    Opacity="0" />
                                                <Rectangle
                                                    x:Name="EnglishLanguageSelectionPill"
                                                    Width="3"
                                                    Height="18"
                                                    Margin="0,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Fill="{ThemeResource IosAccentBrush}"
                                                    Opacity="0"
                                                    RadiusX="1.5"
                                                    RadiusY="1.5" />
                                                <TextBlock
                                                    Margin="14,0,10,0"
                                                    VerticalAlignment="Center"
                                                    Text="English" />
                                            </Grid>
                                        </Button>

                                        <Button
                                            x:Name="RussianLanguageButton"
                                            Click="OnLanguageFlyoutOptionClick"
                                            Style="{StaticResource LanguageFlyoutItemButtonStyle}">
                                            <Grid MinHeight="36">
                                                <Border
                                                    x:Name="RussianLanguageSelectionBackground"
                                                    Background="{ThemeResource IosAccentSoftBrush}"
                                                    CornerRadius="8"
                                                    Opacity="0" />
                                                <Rectangle
                                                    x:Name="RussianLanguageSelectionPill"
                                                    Width="3"
                                                    Height="18"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Fill="{ThemeResource IosAccentBrush}"
                                                    Opacity="0"
                                                    RadiusX="1.5"
                                                    RadiusY="1.5" />
                                                <TextBlock
                                                    Margin="14,0,10,0"
                                                    VerticalAlignment="Center"
                                                    Text="Русский" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    x:Name="LanguageButtonText"
                                    VerticalAlignment="Center"
                                    Text="Русский" />
                                <FontIcon
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="10"
                                    Glyph="&#xE70D;"
                                    IsTextScaleFactorEnabled="False" />
                            </Grid>
                        </Button>

                        <StackPanel
                            x:Name="HideElevateWindowsStackPanel"
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBlock
                                x:Name="HideElevateWindowsLabelTextBlock"
                                Style="{StaticResource ToolbarLabelStyle}"
                                Text="{x:Bind Text.ElevateHiddenModeLabel, Mode=OneTime}" />
                            <ToggleSwitch
                                x:Name="HideElevateWindowsToggle"
                                MinWidth="52"
                                MinHeight="40"
                                AutomationProperties.Name="{x:Bind Text.ElevateHiddenModeLabel, Mode=OneTime}"
                                IsOn="True"
                                OffContent=""
                                OnContent=""
                                Toggled="OnHideElevateWindowsToggleChanged" />
                        </StackPanel>

                    </Grid>
                </Border>

                <ScrollViewer
                    x:Name="MainContentScrollViewer"
                    Grid.Row="1"
                    HorizontalContentAlignment="Stretch"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalContentAlignment="Stretch"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                <Grid
                    x:Name="MainContentGrid"
                    HorizontalAlignment="Stretch"
                    ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftColumnDefinition" Width="*" />
                        <ColumnDefinition x:Name="RightColumnDefinition" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="MainContentFirstRow" Height="*" />
                        <RowDefinition x:Name="MainContentSecondRow" Height="0" />
                    </Grid.RowDefinitions>

                    <Border
                        x:Name="LeftColumnClipBorder"
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource ColumnClipStyle}">
                        <ScrollViewer
                            HorizontalScrollMode="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10">
                                <Border Style="{StaticResource SectionCardStyle}">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Style="{StaticResource SectionIconBadgeStyle}">
                                                <FontIcon Glyph="&#xE8B7;" Style="{StaticResource SectionIconStyle}" />
                                            </Border>
                                            <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionTitleStyle}" Text="{x:Bind Text.FolderTitle, Mode=OneTime}" />
                                        </StackPanel>

                                        <TextBlock
                                            Style="{StaticResource SectionHintStyle}"
                                            Text="{x:Bind Text.FolderHint, Mode=OneTime}" />

                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBox
                                                x:Name="PathTextBox"
                                                Grid.Column="0"
                                                Header="{x:Bind Text.WorkingFolderHeader, Mode=OneTime}"
                                                PlaceholderText="{x:Bind Text.WorkingFolderPlaceholder, Mode=OneTime}"
                                                Style="{StaticResource InputTextBoxStyle}"
                                                TextChanged="OnEditorPathTextChanged" />

                                            <Button
                                                Grid.Column="1"
                                                Margin="0,29,0,0"
                                                AccessKey="B"
                                                Click="OnBrowseFolderButtonClick"
                                                Content="{x:Bind Text.BrowseButton, Mode=OneTime}"
                                                Style="{StaticResource ActionButtonStyle}" />
                                        </Grid>

                                        <StackPanel Spacing="6">
                                            <TextBlock
                                                x:Name="ProjectModeTitleTextBlock"
                                                FontWeight="SemiBold" />

                                            <Border Style="{StaticResource SegmentedContainerStyle}">
                                                <Grid ColumnSpacing="3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <RadioButton
                                                        x:Name="SingleProjectModeButton"
                                                        Grid.Column="0"
                                                        AccessKey="O"
                                                        Click="OnSingleProjectModeButtonClick"
                                                        GroupName="ProcessingMode"
                                                        Style="{StaticResource SegmentedButtonStyle}" />
                                                    <RadioButton
                                                        x:Name="ProjectBatchModeButton"
                                                        Grid.Column="1"
                                                        AccessKey="A"
                                                        Click="OnProjectBatchModeButtonClick"
                                                        GroupName="ProcessingMode"
                                                        Style="{StaticResource SegmentedButtonStyle}" />
                                                </Grid>
                                            </Border>

                                            <TextBlock
                                                x:Name="ProjectModeSuggestionTextBlock"
                                                AutomationProperties.LiveSetting="Polite"
                                                Style="{StaticResource SectionHintStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            <Border
                                x:Name="BuildingTypeCard"
                                Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Style="{StaticResource SectionIconBadgeStyle}">
                                            <FontIcon Glyph="&#xE80F;" Style="{StaticResource SectionIconStyle}" />
                                        </Border>
                                        <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionTitleStyle}" Text="{x:Bind Text.BuildingTypeTitle, Mode=OneTime}" />
                                    </StackPanel>

                                    <TextBlock
                                        Style="{StaticResource SectionHintStyle}"
                                        Text="{x:Bind Text.BuildingTypeHint, Mode=OneTime}" />

                                    <Border Style="{StaticResource SegmentedContainerStyle}">
                                        <Grid ColumnSpacing="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <RadioButton
                                                x:Name="OfficeRadioButton"
                                                Grid.Column="0"
                                                Checked="OnBuildingTypeRadioButtonChecked"
                                                Content="{x:Bind Text.BuildingTypeOffice, Mode=OneTime}"
                                                GroupName="BuildingType"
                                                Style="{StaticResource SegmentedButtonStyle}" />
                                            <RadioButton
                                                x:Name="ResidenceRadioButton"
                                                Grid.Column="1"
                                                Checked="OnBuildingTypeRadioButtonChecked"
                                                Content="{x:Bind Text.BuildingTypeResidence, Mode=OneTime}"
                                                GroupName="BuildingType"
                                                Style="{StaticResource SegmentedButtonStyle}" />
                                            <RadioButton
                                                x:Name="HotelRadioButton"
                                                Grid.Column="2"
                                                Checked="OnBuildingTypeRadioButtonChecked"
                                                Content="{x:Bind Text.BuildingTypeHotel, Mode=OneTime}"
                                                GroupName="BuildingType"
                                                Style="{StaticResource SegmentedButtonStyle}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="EditorWindowCard"
                                Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Style="{StaticResource SectionIconBadgeStyle}">
                                            <FontIcon Glyph="&#xE70F;" Style="{StaticResource SectionIconStyle}" />
                                        </Border>
                                        <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionTitleStyle}" Text="{x:Bind Text.CalculationFileTitle, Mode=OneTime}" />
                                    </StackPanel>

                                    <TextBlock
                                        Style="{StaticResource SectionHintStyle}"
                                        Text="{x:Bind Text.CalculationFileHint, Mode=OneTime}" />

                                    <TextBlock
                                        x:Name="CalculationFileStatusTextBlock"
                                        Style="{StaticResource SectionHintStyle}" />

                                    <Button
                                        x:Name="OpenEditorWindowButton"
                                        AccessKey="E"
                                        Click="OnOpenEditorWindowClick"
                                        Content="{x:Bind Text.OpenEditorWindowButton, Mode=OneTime}"
                                        Style="{StaticResource PrimaryActionButtonStyle}" />
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="ActionsCard"
                                Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Style="{StaticResource SectionIconBadgeStyle}">
                                            <FontIcon Glyph="&#xE768;" Style="{StaticResource SectionIconStyle}" />
                                        </Border>
                                        <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionTitleStyle}" Text="{x:Bind Text.ActionsTitle, Mode=OneTime}" />
                                    </StackPanel>

                                    <TextBlock
                                        Style="{StaticResource SectionHintStyle}"
                                        Text="{x:Bind Text.ActionsHint, Mode=OneTime}" />

                                    <Grid ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Button
                                            x:Name="RunButton"
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            AccessKey="R"
                                            Click="OnRunButtonClick"
                                            Content="{x:Bind Text.RunButton, Mode=OneTime}"
                                            Style="{StaticResource PrimaryActionButtonStyle}" />
                                        <Button
                                            x:Name="RunMorningOnlyButton"
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            AccessKey="M"
                                            Click="OnRunMorningOnlyButtonClick"
                                            Content="{x:Bind Text.RunMorningButton, Mode=OneTime}"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Visibility="Collapsed" />
                                        <Button
                                            x:Name="ReportButton"
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            AccessKey="P"
                                            Click="OnReportButtonClick"
                                            Content="{x:Bind Text.ReportButton, Mode=OneTime}"
                                            Style="{StaticResource ActionButtonStyle}" />
                                        <Button
                                            x:Name="MorningReportButton"
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            AccessKey="P"
                                            Click="OnMorningReportButtonClick"
                                            Content="{x:Bind Text.MorningReportButton, Mode=OneTime}"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Visibility="Collapsed" />
                                        <Button
                                            x:Name="LunchReportButton"
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            AccessKey="L"
                                            Click="OnLunchReportButtonClick"
                                            Content="{x:Bind Text.LunchReportButton, Mode=OneTime}"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Visibility="Collapsed" />
                                        <Button
                                            x:Name="ExitButton"
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            AccessKey="X"
                                            Click="OnExitButtonClick"
                                            Content="{x:Bind Text.ExitButton, Mode=OneTime}"
                                            Style="{StaticResource SubtleActionButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="ProjectBatchCard"
                                Style="{StaticResource SectionCardStyle}"
                                Visibility="Collapsed">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Style="{StaticResource SectionIconBadgeStyle}">
                                            <FontIcon Glyph="&#xE8B7;" Style="{StaticResource SectionIconStyle}" />
                                        </Border>
                                        <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionTitleStyle}" Text="{x:Bind Text.ProjectBatchTitle, Mode=OneTime}" />
                                    </StackPanel>

                                    <TextBlock
                                        Style="{StaticResource SectionHintStyle}"
                                        Text="{x:Bind Text.ProjectBatchHint, Mode=OneTime}" />

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox
                                            x:Name="ProjectBatchPathTextBox"
                                            Grid.Column="0"
                                            Header="{x:Bind Text.ProjectBatchPathHeader, Mode=OneTime}"
                                            PlaceholderText="{x:Bind Text.ProjectBatchPathPlaceholder, Mode=OneTime}"
                                            Style="{StaticResource InputTextBoxStyle}" />

                                        <Button
                                            Grid.Column="1"
                                            Margin="0,29,0,0"
                                            AccessKey="F"
                                            Click="OnBrowseProjectBatchFolderButtonClick"
                                            Content="{x:Bind Text.BrowseButton, Mode=OneTime}"
                                            Style="{StaticResource ActionButtonStyle}" />
                                    </Grid>

                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            x:Name="ProjectBatchParallelRunsLabelTextBlock"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Text.ProjectBatchParallelRunsHeader, Mode=OneTime}" />

                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <NumberBox
                                                x:Name="ProjectBatchParallelRunsNumberBox"
                                                Grid.Column="0"
                                                AutomationProperties.LabeledBy="{Binding ElementName=ProjectBatchParallelRunsLabelTextBlock}"
                                                Minimum="1"
                                                SmallChange="1"
                                                SpinButtonPlacementMode="Compact"
                                                Style="{StaticResource InputNumberBoxStyle}"
                                                Value="4" />

                                            <Grid
                                                Grid.Column="1"
                                                MinHeight="38"
                                                VerticalAlignment="Center"
                                                ColumnSpacing="8"
                                                Tapped="OnProjectBatchUnlimitedRunsOptionTapped">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <ToggleButton
                                                    x:Name="ProjectBatchUnlimitedRunsCheckBox"
                                                    AutomationProperties.Name="{x:Bind Text.ProjectBatchUnlimitedRuns, Mode=OneTime}"
                                                    Style="{StaticResource RoundCheckToggleStyle}" />

                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind Text.ProjectBatchUnlimitedRuns, Mode=OneTime}" />
                                            </Grid>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Text.ProjectBatchOfficeScenariosHeader, Mode=OneTime}" />

                                        <Grid
                                            MinHeight="38"
                                            VerticalAlignment="Center"
                                            ColumnSpacing="8"
                                            Tapped="OnProjectBatchMorningOnlyOptionTapped">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <ToggleButton
                                                x:Name="ProjectBatchMorningOnlyCheckBox"
                                                AutomationProperties.Name="{x:Bind Text.ProjectBatchMorningOnly, Mode=OneTime}"
                                                Style="{StaticResource RoundCheckToggleStyle}" />

                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind Text.ProjectBatchMorningOnly, Mode=OneTime}" />
                                        </Grid>

                                        <TextBlock
                                            Style="{StaticResource SectionHintStyle}"
                                            Text="{x:Bind Text.ProjectBatchOfficeScenariosHint, Mode=OneTime}" />
                                    </StackPanel>

                                    <Button
                                        x:Name="RunProjectBatchButton"
                                        AccessKey="R"
                                        Click="OnRunProjectBatchButtonClick"
                                        Content="{x:Bind Text.ProjectBatchRunButton, Mode=OneTime}"
                                        Style="{StaticResource PrimaryActionButtonStyle}" />
                                </StackPanel>
                            </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border
                        x:Name="QueueCard"
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource SectionCardStyle}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ProgressRing
                                    x:Name="BusyRing"
                                    Width="18"
                                    Height="18"
                                    IsActive="False"
                                    VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionTitleStyle}" Text="{x:Bind Text.QueueTitle, Mode=OneTime}" />
                                    <TextBlock
                                        x:Name="BusyTextBlock"
                                        AutomationProperties.LiveSetting="Polite"
                                        Style="{StaticResource SectionHintStyle}"
                                        Text="{x:Bind Text.Ready, Mode=OneTime}" />
                                </StackPanel>
                            </Grid>

                            <Grid
                                x:Name="BatchQueueControlsPanel"
                                Grid.Row="1"
                                ColumnSpacing="8"
                                Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    x:Name="StopQueuedJobsButton"
                                    Grid.Column="0"
                                    AccessKey="Q"
                                    Click="OnStopQueuedJobsButtonClick"
                                    Style="{StaticResource ActionButtonStyle}" />
                                <Button
                                    x:Name="StopAllJobsButton"
                                    Grid.Column="1"
                                    AccessKey="S"
                                    Click="OnStopAllJobsButtonClick"
                                    Style="{StaticResource ActionButtonStyle}" />
                            </Grid>

                            <Grid Grid.Row="2">
                                <Border
                                    x:Name="EmptyQueueBorder"
                                    MinHeight="104"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource IosSecondaryGroupedBrush}"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="24"
                                    Padding="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Text.NoActiveJobsTitle, Mode=OneTime}" />
                                        <TextBlock
                                            Style="{StaticResource SectionHintStyle}"
                                            Text="{x:Bind Text.NoActiveJobsHint, Mode=OneTime}" />
                                    </StackPanel>
                                </Border>

                                <ScrollViewer
                                    HorizontalScrollMode="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <ItemsControl
                                        x:Name="JobsItemsControl"
                                        ItemsSource="{x:Bind Jobs, Mode=OneTime}"
                                        Visibility="Collapsed">
                                        <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="10">
                                                        <StackPanel.ChildrenTransitions>
                                                            <TransitionCollection>
                                                                <AddDeleteThemeTransition />
                                                                <RepositionThemeTransition />
                                                            </TransitionCollection>
                                                        </StackPanel.ChildrenTransitions>
                                                    </StackPanel>
                                                </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Background="{ThemeResource IosSecondaryGroupedBrush}"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="22"
                                                    Padding="14">
                                                    <StackPanel Spacing="8">
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Spacing="1">
                                                                <TextBlock
                                                                    FontSize="15"
                                                                    FontWeight="SemiBold"
                                                                    Text="{Binding Title}"
                                                                    TextWrapping="Wrap" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource IosSubtleTextBrush}"
                                                                    Text="{Binding Details}"
                                                                    TextWrapping="Wrap" />
                                                            </StackPanel>

                                                            <TextBlock
                                                                Grid.Column="1"
                                                                MaxWidth="160"
                                                                HorizontalAlignment="Right"
                                                                Foreground="{ThemeResource IosSubtleTextBrush}"
                                                                Text="{Binding HeaderStatusText}"
                                                                TextTrimming="CharacterEllipsis"
                                                                TextWrapping="NoWrap"
                                                                Visibility="{Binding HeaderStatusVisibility}" />

                                                            <Button
                                                                Grid.Column="2"
                                                                AutomationProperties.Name="{Binding DismissButtonText}"
                                                                Click="OnDismissJobButtonClick"
                                                                Style="{StaticResource DismissJobButtonStyle}"
                                                                Tag="{Binding}"
                                                                ToolTipService.ToolTip="{Binding DismissButtonText}"
                                                                Visibility="{Binding DismissButtonVisibility}">
                                                                <FontIcon
                                                                    FontFamily="Segoe MDL2 Assets"
                                                                    FontSize="16"
                                                                    Glyph="&#xE711;"
                                                                    IsTextScaleFactorEnabled="False" />
                                                            </Button>
                                                        </Grid>

                                                        <Border
                                                            Background="{ThemeResource IosCriticalSoftBrush}"
                                                            BorderBrush="{ThemeResource IosCriticalTextBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="14"
                                                            Padding="10"
                                                            Visibility="{Binding FailureMessageVisibility}">
                                                            <TextBox
                                                                AcceptsReturn="True"
                                                                AutomationProperties.Name="{Binding FailureMessage}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Foreground="{ThemeResource IosCriticalTextBrush}"
                                                                IsReadOnly="True"
                                                                Padding="0"
                                                                Text="{Binding FailureMessage}"
                                                                TextWrapping="Wrap" />
                                                        </Border>

                                                        <ItemsControl ItemsSource="{Binding Scenarios}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Spacing="8" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Spacing="4">
                                                                        <Grid ColumnSpacing="12">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>

                                                                            <TextBlock
                                                                                Grid.Column="0"
                                                                                FontWeight="Medium"
                                                                                Text="{Binding Label}" />

                                                                            <TextBlock
                                                                                Grid.Column="1"
                                                                                Foreground="{ThemeResource IosSubtleTextBrush}"
                                                                                HorizontalAlignment="Right"
                                                                                Text="{Binding ProgressText}" />

                                                                            <Button
                                                                                Grid.Column="2"
                                                                                Click="OnRetryScenarioButtonClick"
                                                                                Content="{Binding RetryButtonText}"
                                                                                IsEnabled="{Binding CanRetry}"
                                                                                Style="{StaticResource ActionButtonStyle}"
                                                                                Tag="{Binding}"
                                                                                Visibility="{Binding RetryButtonVisibility}" />
                                                                        </Grid>

                                                                        <ProgressBar
                                                                            AutomationProperties.Name="{Binding Label}"
                                                                            IsIndeterminate="{Binding IsIndeterminate}"
                                                                            Maximum="{Binding Maximum}"
                                                                            Style="{StaticResource ScenarioProgressBarStyle}"
                                                                            Value="{Binding Value}" />

                                                                        <TextBox
                                                                            AcceptsReturn="True"
                                                                            AutomationProperties.Name="{Binding FailureMessage}"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                            IsReadOnly="True"
                                                                            Padding="0"
                                                                            Text="{Binding FailureMessage}"
                                                                            TextWrapping="Wrap"
                                                                            Visibility="{Binding FailureMessageVisibility}" />

                                                                        <TextBlock
                                                                            FontSize="12"
                                                                            Foreground="{ThemeResource IosSubtleTextBrush}"
                                                                            Text="{Binding MetricsText}"
                                                                            Visibility="{Binding MetricsVisibility}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Button
                                                                Click="OnStopJobButtonClick"
                                                                Content="{Binding StopButtonText}"
                                                                IsEnabled="{Binding CanStop}"
                                                                Style="{StaticResource ActionButtonStyle}"
                                                                Tag="{Binding}"
                                                                Visibility="{Binding StopButtonVisibility}" />
                                                            <Button
                                                                Click="OnJobReportButtonClick"
                                                                Content="{Binding ReportButtonText}"
                                                                IsEnabled="{Binding CanPrintReport}"
                                                                Style="{StaticResource ActionButtonStyle}"
                                                                Tag="{Binding}"
                                                                Visibility="{Binding PrintReportVisibility}" />
                                                            <Button
                                                                Click="OnRetryJobButtonClick"
                                                                Content="{Binding RetryButtonText}"
                                                                IsEnabled="{Binding CanRetry}"
                                                                Style="{StaticResource ActionButtonStyle}"
                                                                Tag="{Binding}"
                                                                Visibility="{Binding RetryButtonVisibility}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <InfoBar
                                x:Name="StatusInfoBar"
                                Grid.Row="3"
                                AutomationProperties.LiveSetting="Polite"
                                IsOpen="False"
                                IsClosable="False"
                                Severity="Success"
                                Title="{x:Bind Text.StatusTitle, Mode=OneTime}">
                                <InfoBar.ActionButton>
                                    <Button
                                        x:Name="StatusActionButton"
                                        Click="OnStatusActionButtonClick"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Visibility="Collapsed" />
                                </InfoBar.ActionButton>
                            </InfoBar>
                        </Grid>
                    </Border>
                </Grid>
                </ScrollViewer>
        </Grid>

        <Grid Visibility="Collapsed">
            <StackPanel>
                <Button x:Name="LoadEditorButton" Click="OnLoadEditorButtonClick" Content="{x:Bind Text.LoadEditorButton, Mode=OneTime}" />
                <Button x:Name="LoadEditorTemplateButton" Click="OnLoadEditorTemplateButtonClick" Content="{x:Bind Text.LoadEditorTemplateButton, Mode=OneTime}" />
                <Button x:Name="SaveEditorButton" Click="OnSaveEditorButtonClick" Content="{x:Bind Text.SaveEditorButton, Mode=OneTime}" IsEnabled="False" />
                <TextBlock x:Name="EditorSourceTextBlock" />
                <TextBlock x:Name="EditorOutputTextBlock" />
                <TextBox x:Name="EditorJobTitleTextBox" TextChanged="OnEditorOutputFieldsChanged" />
                <TextBox x:Name="EditorJobNoTextBox" TextChanged="OnEditorOutputFieldsChanged" />
                <TextBox x:Name="EditorCalculationTitleTextBox" />
                <TextBox x:Name="EditorMadeByTextBox" />
                <TextBox x:Name="EditorCheckedByTextBox" />
                <TextBox x:Name="EditorCompanyTextBox" />
                <TextBox x:Name="EditorDispatcherTextBox" />
                <TextBox x:Name="EditorTrafficModeTextBox" />
                <TextBox x:Name="EditorSimulationsTextBox" />
                <TextBox x:Name="EditorLearningRunsTextBox" />
                <TextBox x:Name="EditorRandomSeedTextBox" />
                <TextBox x:Name="EditorAbsenteeismTextBox" />
                <TextBox x:Name="EditorIncomingTextBox" />
                <TextBox x:Name="EditorOutgoingTextBox" />
                <TextBox x:Name="EditorInterfloorTextBox" />
                <TextBox x:Name="EditorHandlingCapacityTextBox" />
                <TextBox x:Name="EditorLoadingTimeTextBox" />
                <TextBox x:Name="EditorUnloadingTimeTextBox" />
                <ItemsControl x:Name="EditorFloorsItemsControl" ItemsSource="{x:Bind EditorFloors, Mode=OneTime}" />
                <ItemsControl x:Name="EditorCarsItemsControl" ItemsSource="{x:Bind EditorCars, Mode=OneTime}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
