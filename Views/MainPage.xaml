<?xml version="1.0" encoding="UTF-8"?>
<Page
    x:Class="ElevateHelperWinUI.Views.MainPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid
        Padding="18"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Border
            MaxWidth="1180"
            HorizontalAlignment="Center"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        VerticalAlignment="Center"
                        Source="ms-appx:///Assets/AppIcon.png" />

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="{x:Bind Text.AppTitle, Mode=OneTime}" />

                    <ComboBox
                        x:Name="LanguageComboBox"
                        Grid.Column="2"
                        DisplayMemberPath="DisplayName"
                        Header="{x:Bind Text.LanguageLabel, Mode=OneTime}"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind LanguageOptions, Mode=OneTime}"
                        SelectionChanged="OnLanguageComboBoxSelectionChanged" />

                    <CheckBox
                        x:Name="BetaFeaturesCheckBox"
                        Grid.Column="3"
                        Margin="0,27,0,0"
                        Checked="OnBetaFeaturesCheckBoxChanged"
                        Content="BETA"
                        FontWeight="SemiBold"
                        Unchecked="OnBetaFeaturesCheckBoxChanged" />
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="392" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer
                        Grid.Column="0"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Style="{StaticResource SectionIconBadgeStyle}">
                                            <SymbolIcon Symbol="Folder" />
                                        </Border>
                                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Bind Text.FolderTitle, Mode=OneTime}" />
                                    </StackPanel>

                                    <TextBlock
                                        Style="{StaticResource SectionHintStyle}"
                                        Text="{x:Bind Text.FolderHint, Mode=OneTime}" />

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox
                                            x:Name="PathTextBox"
                                            Grid.Column="0"
                                            Header="{x:Bind Text.WorkingFolderHeader, Mode=OneTime}"
                                            PlaceholderText="{x:Bind Text.WorkingFolderPlaceholder, Mode=OneTime}"
                                            TextChanged="OnEditorPathTextChanged" />

                                        <Button
                                            Grid.Column="1"
                                            Margin="0,29,0,0"
                                            Click="OnBrowseFolderButtonClick"
                                            Content="{x:Bind Text.BrowseButton, Mode=OneTime}"
                                            Style="{StaticResource ActionButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Style="{StaticResource SectionIconBadgeStyle}">
                                            <SymbolIcon Symbol="Home" />
                                        </Border>
                                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Bind Text.BuildingTypeTitle, Mode=OneTime}" />
                                    </StackPanel>

                                    <TextBlock
                                        Style="{StaticResource SectionHintStyle}"
                                        Text="{x:Bind Text.BuildingTypeHint, Mode=OneTime}" />

                                    <StackPanel Spacing="2">
                                        <RadioButton
                                            x:Name="OfficeRadioButton"
                                            Checked="OnBuildingTypeRadioButtonChecked"
                                            Content="{x:Bind Text.BuildingTypeOffice, Mode=OneTime}"
                                            FontWeight="SemiBold"
                                            GroupName="BuildingTypeGroup" />
                                        <RadioButton
                                            x:Name="ResidenceRadioButton"
                                            Checked="OnBuildingTypeRadioButtonChecked"
                                            Content="{x:Bind Text.BuildingTypeResidence, Mode=OneTime}"
                                            FontWeight="SemiBold"
                                            GroupName="BuildingTypeGroup" />
                                        <RadioButton
                                            x:Name="HotelRadioButton"
                                            Checked="OnBuildingTypeRadioButtonChecked"
                                            Content="{x:Bind Text.BuildingTypeHotel, Mode=OneTime}"
                                            FontWeight="SemiBold"
                                            GroupName="BuildingTypeGroup" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Style="{StaticResource SectionIconBadgeStyle}">
                                            <SymbolIcon Symbol="Play" />
                                        </Border>
                                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Bind Text.ActionsTitle, Mode=OneTime}" />
                                    </StackPanel>

                                    <TextBlock
                                        Style="{StaticResource SectionHintStyle}"
                                        Text="{x:Bind Text.ActionsHint, Mode=OneTime}" />

                                    <Grid ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Button
                                            x:Name="RunButton"
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Click="OnRunButtonClick"
                                            Content="{x:Bind Text.RunButton, Mode=OneTime}"
                                            Style="{StaticResource PrimaryActionButtonStyle}" />
                                        <Button
                                            x:Name="RunMorningOnlyButton"
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Click="OnRunMorningOnlyButtonClick"
                                            Content="{x:Bind Text.RunMorningButton, Mode=OneTime}"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Visibility="Collapsed" />
                                        <Button
                                            x:Name="ReportButton"
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Click="OnReportButtonClick"
                                            Content="{x:Bind Text.ReportButton, Mode=OneTime}"
                                            Style="{StaticResource ActionButtonStyle}" />
                                        <Button
                                            x:Name="MorningReportButton"
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Click="OnMorningReportButtonClick"
                                            Content="{x:Bind Text.MorningReportButton, Mode=OneTime}"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Visibility="Collapsed" />
                                        <Button
                                            x:Name="LunchReportButton"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Click="OnLunchReportButtonClick"
                                            Content="{x:Bind Text.LunchReportButton, Mode=OneTime}"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Visibility="Collapsed" />
                                        <Button
                                            x:Name="ExitButton"
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Click="OnExitButtonClick"
                                            Content="{x:Bind Text.ExitButton, Mode=OneTime}"
                                            Style="{StaticResource ActionButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="ProjectBatchCard"
                                Style="{StaticResource SectionCardStyle}"
                                Visibility="Collapsed">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Style="{StaticResource SectionIconBadgeStyle}">
                                            <SymbolIcon Symbol="Folder" />
                                        </Border>
                                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Bind Text.ProjectBatchTitle, Mode=OneTime}" />
                                    </StackPanel>

                                    <TextBlock
                                        Style="{StaticResource SectionHintStyle}"
                                        Text="{x:Bind Text.ProjectBatchHint, Mode=OneTime}" />

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox
                                            x:Name="ProjectBatchPathTextBox"
                                            Grid.Column="0"
                                            Header="{x:Bind Text.ProjectBatchPathHeader, Mode=OneTime}"
                                            PlaceholderText="{x:Bind Text.ProjectBatchPathPlaceholder, Mode=OneTime}" />

                                        <Button
                                            Grid.Column="1"
                                            Margin="0,29,0,0"
                                            Click="OnBrowseProjectBatchFolderButtonClick"
                                            Content="{x:Bind Text.BrowseButton, Mode=OneTime}"
                                            Style="{StaticResource ActionButtonStyle}" />
                                    </Grid>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <NumberBox
                                            x:Name="ProjectBatchParallelRunsNumberBox"
                                            Grid.Column="0"
                                            Header="{x:Bind Text.ProjectBatchParallelRunsHeader, Mode=OneTime}"
                                            Minimum="1"
                                            SmallChange="1"
                                            SpinButtonPlacementMode="Compact"
                                            Value="4" />

                                        <CheckBox
                                            x:Name="ProjectBatchUnlimitedRunsCheckBox"
                                            Grid.Column="1"
                                            Margin="0,29,0,0"
                                            Content="{x:Bind Text.ProjectBatchUnlimitedRuns, Mode=OneTime}" />
                                    </Grid>

                                    <Button
                                        Click="OnRunProjectBatchButtonClick"
                                        Content="{x:Bind Text.ProjectBatchRunButton, Mode=OneTime}"
                                        Style="{StaticResource PrimaryActionButtonStyle}" />
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="EditorWindowCard"
                                Style="{StaticResource SectionCardStyle}"
                                Visibility="Collapsed">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Style="{StaticResource SectionIconBadgeStyle}">
                                            <SymbolIcon Symbol="Edit" />
                                        </Border>
                                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Bind Text.EditorTitle, Mode=OneTime}" />
                                    </StackPanel>

                                    <TextBlock
                                        Style="{StaticResource SectionHintStyle}"
                                        Text="{x:Bind Text.EditorWindowHint, Mode=OneTime}" />

                                    <Button
                                        Click="OnOpenEditorWindowClick"
                                        Content="{x:Bind Text.OpenEditorWindowButton, Mode=OneTime}"
                                        Style="{StaticResource PrimaryActionButtonStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border
                        Grid.Column="1"
                        Style="{StaticResource SectionCardStyle}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ProgressRing
                                    x:Name="BusyRing"
                                    Width="18"
                                    Height="18"
                                    IsActive="False"
                                    VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Bind Text.QueueTitle, Mode=OneTime}" />
                                    <TextBlock
                                        x:Name="BusyTextBlock"
                                        Style="{StaticResource SectionHintStyle}"
                                        Text="{x:Bind Text.Ready, Mode=OneTime}" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Border
                                    x:Name="EmptyQueueBorder"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Text.NoActiveJobsTitle, Mode=OneTime}" />
                                        <TextBlock
                                            Style="{StaticResource SectionHintStyle}"
                                            Text="{x:Bind Text.NoActiveJobsHint, Mode=OneTime}" />
                                    </StackPanel>
                                </Border>

                                <ScrollViewer
                                    HorizontalScrollMode="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <ItemsControl
                                        x:Name="JobsItemsControl"
                                        ItemsSource="{x:Bind Jobs, Mode=OneTime}"
                                        Visibility="Collapsed">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="10" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12">
                                                    <StackPanel Spacing="8">
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Spacing="1">
                                                                <TextBlock
                                                                    FontSize="15"
                                                                    FontWeight="SemiBold"
                                                                    Text="{Binding Title}"
                                                                    TextWrapping="Wrap" />
                                                                <TextBlock
                                                                    Opacity="0.72"
                                                                    Text="{Binding Details}"
                                                                    TextWrapping="Wrap" />
                                                            </StackPanel>

                                                            <TextBlock
                                                                Grid.Column="1"
                                                                HorizontalAlignment="Right"
                                                                Opacity="0.8"
                                                                Text="{Binding StatusText}"
                                                                TextWrapping="Wrap" />
                                                        </Grid>

                                                        <ItemsControl ItemsSource="{Binding Scenarios}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Spacing="8" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Spacing="4">
                                                                        <Grid ColumnSpacing="12">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>

                                                                            <TextBlock
                                                                                Grid.Column="0"
                                                                                FontWeight="Medium"
                                                                                Text="{Binding Label}" />

                                                                            <TextBlock
                                                                                Grid.Column="1"
                                                                                HorizontalAlignment="Right"
                                                                                Opacity="0.7"
                                                                                Text="{Binding ProgressText}" />
                                                                        </Grid>

                                                                        <ProgressBar
                                                                            Height="5"
                                                                            IsIndeterminate="{Binding IsIndeterminate}"
                                                                            Maximum="{Binding Maximum}"
                                                                            Value="{Binding Value}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Button
                                                                Click="OnJobReportButtonClick"
                                                                Content="{Binding ReportButtonText}"
                                                                IsEnabled="{Binding CanPrintReport}"
                                                                Style="{StaticResource ActionButtonStyle}"
                                                                Tag="{Binding}"
                                                                Visibility="{Binding PrintReportVisibility}" />
                                                            <Button
                                                                Click="OnRetryJobButtonClick"
                                                                Content="{Binding RetryButtonText}"
                                                                IsEnabled="{Binding CanRetry}"
                                                                Style="{StaticResource ActionButtonStyle}"
                                                                Tag="{Binding}"
                                                                Visibility="{Binding RetryButtonVisibility}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <InfoBar
                                x:Name="StatusInfoBar"
                                Grid.Row="2"
                                IsOpen="False"
                                IsClosable="False"
                                Message="{x:Bind Text.Ready, Mode=OneTime}"
                                Severity="Success"
                                Title="{x:Bind Text.StatusTitle, Mode=OneTime}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid Visibility="Collapsed">
            <StackPanel>
                <Button x:Name="LoadEditorButton" Click="OnLoadEditorButtonClick" Content="{x:Bind Text.LoadEditorButton, Mode=OneTime}" />
                <Button x:Name="LoadEditorTemplateButton" Click="OnLoadEditorTemplateButtonClick" Content="{x:Bind Text.LoadEditorTemplateButton, Mode=OneTime}" />
                <Button x:Name="SaveEditorButton" Click="OnSaveEditorButtonClick" Content="{x:Bind Text.SaveEditorButton, Mode=OneTime}" IsEnabled="False" />
                <TextBlock x:Name="EditorSourceTextBlock" />
                <TextBlock x:Name="EditorOutputTextBlock" />
                <TextBox x:Name="EditorJobTitleTextBox" TextChanged="OnEditorOutputFieldsChanged" />
                <TextBox x:Name="EditorJobNoTextBox" TextChanged="OnEditorOutputFieldsChanged" />
                <TextBox x:Name="EditorCalculationTitleTextBox" />
                <TextBox x:Name="EditorMadeByTextBox" />
                <TextBox x:Name="EditorCheckedByTextBox" />
                <TextBox x:Name="EditorCompanyTextBox" />
                <TextBox x:Name="EditorDispatcherTextBox" />
                <TextBox x:Name="EditorTrafficModeTextBox" />
                <TextBox x:Name="EditorSimulationsTextBox" />
                <TextBox x:Name="EditorLearningRunsTextBox" />
                <TextBox x:Name="EditorRandomSeedTextBox" />
                <TextBox x:Name="EditorAbsenteeismTextBox" />
                <TextBox x:Name="EditorIncomingTextBox" />
                <TextBox x:Name="EditorOutgoingTextBox" />
                <TextBox x:Name="EditorInterfloorTextBox" />
                <TextBox x:Name="EditorHandlingCapacityTextBox" />
                <TextBox x:Name="EditorLoadingTimeTextBox" />
                <TextBox x:Name="EditorUnloadingTimeTextBox" />
                <ItemsControl x:Name="EditorFloorsItemsControl" ItemsSource="{x:Bind EditorFloors, Mode=OneTime}" />
                <ItemsControl x:Name="EditorCarsItemsControl" ItemsSource="{x:Bind EditorCars, Mode=OneTime}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
