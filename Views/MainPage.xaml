<?xml version="1.0" encoding="UTF-8"?>
<Page
    x:Class="ElevateHelperWinUI.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            FontSize="32"
            FontWeight="SemiBold"
            Text="Elevate Helper" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="960" Spacing="16">
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Elevate Folder" />
                        <TextBlock Opacity="0.8" Text="Path to folder containing source .elvx files" />
                        <TextBox
                            x:Name="PathTextBox"
                            PlaceholderText="Example: C:\Elevate\ProjectA" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Building Type" />
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <RadioButton
                                x:Name="OfficeRadioButton"
                                Checked="OnBuildingTypeRadioButtonChecked"
                                Content="Office"
                                GroupName="BuildingTypeGroup" />
                            <RadioButton
                                x:Name="ResidenceRadioButton"
                                Checked="OnBuildingTypeRadioButtonChecked"
                                Content="Residence"
                                GroupName="BuildingTypeGroup" />
                            <RadioButton
                                x:Name="HotelRadioButton"
                                Checked="OnBuildingTypeRadioButtonChecked"
                                Content="Hotel"
                                GroupName="BuildingTypeGroup" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Actions" />

                        <CommandBar DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
                            <AppBarButton x:Name="RunButton" Click="OnRunButtonClick" Label="Run">
                                <AppBarButton.Icon>
                                    <SymbolIcon Symbol="Play" />
                                </AppBarButton.Icon>
                            </AppBarButton>

                            <AppBarButton
                                x:Name="RunMorningOnlyButton"
                                Click="OnRunMorningOnlyButtonClick"
                                Label="Run Morning Only"
                                Visibility="Collapsed">
                                <AppBarButton.Icon>
                                    <SymbolIcon Symbol="Forward" />
                                </AppBarButton.Icon>
                            </AppBarButton>

                            <AppBarSeparator />

                            <AppBarButton x:Name="ExitButton" Click="OnExitButtonClick" Label="Exit">
                                <AppBarButton.Icon>
                                    <SymbolIcon Symbol="Cancel" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button
                                x:Name="ReportButton"
                                Click="OnReportButtonClick"
                                Content="Print Report"
                                Style="{StaticResource ActionButtonStyle}" />
                            <Button
                                x:Name="MorningReportButton"
                                Click="OnMorningReportButtonClick"
                                Content="Print Morning Report"
                                Style="{StaticResource ActionButtonStyle}"
                                Visibility="Collapsed" />
                            <Button
                                x:Name="LunchReportButton"
                                Click="OnLunchReportButtonClick"
                                Content="Print Lunch Report"
                                Style="{StaticResource ActionButtonStyle}"
                                Visibility="Collapsed" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="BusyRing" Width="18" Height="18" IsActive="False" />
                            <TextBlock x:Name="BusyTextBlock" Opacity="0.7" Text="Ready" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <InfoBar
                    x:Name="StatusInfoBar"
                    IsOpen="True"
                    IsClosable="False"
                    Title="Checkup"
                    Message="OK!"
                    Severity="Success" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
