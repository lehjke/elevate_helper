<?xml version="1.0" encoding="UTF-8"?>
<Page
    x:Class="ElevateHelperWinUI.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel
                MaxWidth="860"
                HorizontalAlignment="Center"
                Spacing="16"
                Margin="20,18,20,24">
                <Border Style="{StaticResource HeroCardStyle}">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Style="{StaticResource HeroTitleTextStyle}"
                            Text="{x:Bind Text.AppTitle, Mode=OneWay}" />

                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock
                                Style="{StaticResource SectionHintStyle}"
                                Text="{x:Bind Text.LanguageLabel, Mode=OneWay}" />
                            <ComboBox
                                x:Name="LanguageComboBox"
                                DisplayMemberPath="DisplayName"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind LanguageOptions, Mode=OneWay}"
                                SelectionChanged="OnLanguageComboBoxSelectionChanged" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource SectionIconBadgeStyle}">
                                <SymbolIcon Symbol="Folder" />
                            </Border>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Bind Text.FolderTitle, Mode=OneWay}" />
                        </StackPanel>

                        <TextBlock
                            Style="{StaticResource SectionHintStyle}"
                            Text="{x:Bind Text.FolderHint, Mode=OneWay}" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                x:Name="PathTextBox"
                                Grid.Column="0"
                                Header="{x:Bind Text.WorkingFolderHeader, Mode=OneWay}"
                                PlaceholderText="{x:Bind Text.WorkingFolderPlaceholder, Mode=OneWay}" />

                            <Button
                                Grid.Column="1"
                                Margin="0,30,0,0"
                                Click="OnBrowseFolderButtonClick"
                                Content="{x:Bind Text.BrowseButton, Mode=OneWay}"
                                Style="{StaticResource ActionButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource SectionIconBadgeStyle}">
                                <SymbolIcon Symbol="Home" />
                            </Border>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Bind Text.BuildingTypeTitle, Mode=OneWay}" />
                        </StackPanel>

                        <TextBlock
                            Style="{StaticResource SectionHintStyle}"
                            Text="{x:Bind Text.BuildingTypeHint, Mode=OneWay}" />

                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <RadioButton
                                x:Name="OfficeRadioButton"
                                Checked="OnBuildingTypeRadioButtonChecked"
                                Content="{x:Bind Text.BuildingTypeOffice, Mode=OneWay}"
                                FontWeight="SemiBold"
                                GroupName="BuildingTypeGroup" />
                            <RadioButton
                                x:Name="ResidenceRadioButton"
                                Checked="OnBuildingTypeRadioButtonChecked"
                                Content="{x:Bind Text.BuildingTypeResidence, Mode=OneWay}"
                                FontWeight="SemiBold"
                                GroupName="BuildingTypeGroup" />
                            <RadioButton
                                x:Name="HotelRadioButton"
                                Checked="OnBuildingTypeRadioButtonChecked"
                                Content="{x:Bind Text.BuildingTypeHotel, Mode=OneWay}"
                                FontWeight="SemiBold"
                                GroupName="BuildingTypeGroup" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource SectionIconBadgeStyle}">
                                <SymbolIcon Symbol="Play" />
                            </Border>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Bind Text.ActionsTitle, Mode=OneWay}" />
                        </StackPanel>

                        <CommandBar DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
                            <AppBarButton x:Name="RunButton" Click="OnRunButtonClick" Label="{x:Bind Text.RunButton, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <SymbolIcon Symbol="Play" />
                                </AppBarButton.Icon>
                            </AppBarButton>

                            <AppBarButton
                                x:Name="RunMorningOnlyButton"
                                Click="OnRunMorningOnlyButtonClick"
                                Label="{x:Bind Text.RunMorningButton, Mode=OneWay}"
                                Visibility="Collapsed">
                                <AppBarButton.Icon>
                                    <SymbolIcon Symbol="Forward" />
                                </AppBarButton.Icon>
                            </AppBarButton>

                            <AppBarSeparator />

                            <AppBarButton x:Name="ExitButton" Click="OnExitButtonClick" Label="{x:Bind Text.ExitButton, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <SymbolIcon Symbol="Cancel" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar>

                        <TextBlock
                            Style="{StaticResource SectionHintStyle}"
                            Text="{x:Bind Text.ActionsHint, Mode=OneWay}" />

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button
                                x:Name="ReportButton"
                                Click="OnReportButtonClick"
                                Content="{x:Bind Text.ReportButton, Mode=OneWay}"
                                Style="{StaticResource PrimaryActionButtonStyle}" />
                            <Button
                                x:Name="MorningReportButton"
                                Click="OnMorningReportButtonClick"
                                Content="{x:Bind Text.MorningReportButton, Mode=OneWay}"
                                Style="{StaticResource ActionButtonStyle}"
                                Visibility="Collapsed" />
                            <Button
                                x:Name="LunchReportButton"
                                Click="OnLunchReportButtonClick"
                                Content="{x:Bind Text.LunchReportButton, Mode=OneWay}"
                                Style="{StaticResource ActionButtonStyle}"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ProgressRing
                                x:Name="BusyRing"
                                Width="18"
                                Height="18"
                                IsActive="False"
                                VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Bind Text.QueueTitle, Mode=OneWay}" />
                                <TextBlock
                                    x:Name="BusyTextBlock"
                                    Style="{StaticResource SectionHintStyle}"
                                    Text="{x:Bind Text.Ready, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>

                        <Border
                            x:Name="EmptyQueueBorder"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="16">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Text.NoActiveJobsTitle, Mode=OneWay}" />
                                <TextBlock
                                    Style="{StaticResource SectionHintStyle}"
                                    Text="{x:Bind Text.NoActiveJobsHint, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <ItemsControl
                            x:Name="JobsItemsControl"
                            ItemsSource="{x:Bind Jobs, Mode=OneWay}"
                            Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="14">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock
                                                        FontSize="16"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Title}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Opacity="0.72"
                                                        Text="{Binding Details}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>

                                                <TextBlock
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    Opacity="0.8"
                                                    Text="{Binding StatusText}"
                                                    TextWrapping="Wrap" />
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding Scenarios}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Spacing="10" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Spacing="4">
                                                            <Grid ColumnSpacing="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock
                                                                    Grid.Column="0"
                                                                    FontWeight="Medium"
                                                                    Text="{Binding Label}" />

                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    HorizontalAlignment="Right"
                                                                    Opacity="0.7"
                                                                    Text="{Binding ProgressText}" />
                                                            </Grid>

                                                            <ProgressBar
                                                                Height="6"
                                                                IsIndeterminate="{Binding IsIndeterminate}"
                                                                Maximum="{Binding Maximum}"
                                                                Value="{Binding Value}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <InfoBar
                    x:Name="StatusInfoBar"
                    IsOpen="False"
                    IsClosable="False"
                    Title="{x:Bind Text.StatusTitle, Mode=OneWay}"
                    Message="{x:Bind Text.Ready, Mode=OneWay}"
                    Severity="Success" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

