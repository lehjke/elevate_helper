<?xml version="1.0" encoding="UTF-8"?>
<Page
    x:Class="ElevateHelperWinUI.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            FontSize="32"
            FontWeight="SemiBold"
            Text="Elevate Helper" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="960" Spacing="16">
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Elevate Folder" />
                        <TextBlock Opacity="0.8" Text="Path to folder containing source .elvx files" />
                        <TextBox x:ConnectionId='14'
                            x:Name="PathTextBox"
                            PlaceholderText="Example: C:\Elevate\ProjectA" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Building Type" />
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <RadioButton x:ConnectionId='11'
                                x:Name="OfficeRadioButton"
                                                                          
                                Content="Office"
                                GroupName="BuildingTypeGroup" />
                            <RadioButton x:ConnectionId='12'
                                x:Name="ResidenceRadioButton"
                                                                          
                                Content="Residence"
                                GroupName="BuildingTypeGroup" />
                            <RadioButton x:ConnectionId='13'
                                x:Name="HotelRadioButton"
                                                                          
                                Content="Hotel"
                                GroupName="BuildingTypeGroup" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Actions" />

                        <CommandBar DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
                            <AppBarButton x:ConnectionId='8' x:Name="RunButton"                          Label="Run">
                                <AppBarButton.Icon>
                                    <SymbolIcon Symbol="Play" />
                                </AppBarButton.Icon>
                            </AppBarButton>

                            <AppBarButton x:ConnectionId='9'
                                x:Name="RunMorningOnlyButton"
                                                                   
                                Label="Run Morning Only"
                                Visibility="Collapsed">
                                <AppBarButton.Icon>
                                    <SymbolIcon Symbol="Forward" />
                                </AppBarButton.Icon>
                            </AppBarButton>

                            <AppBarSeparator />

                            <AppBarButton x:ConnectionId='10' x:Name="ExitButton"                           Label="Exit">
                                <AppBarButton.Icon>
                                    <SymbolIcon Symbol="Cancel" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:ConnectionId='5'
                                x:Name="ReportButton"
                                                           
                                Content="Print Report"
                                Style="{StaticResource ActionButtonStyle}" />
                            <Button x:ConnectionId='6'
                                x:Name="MorningReportButton"
                                                                  
                                Content="Print Morning Report"
                                Style="{StaticResource ActionButtonStyle}"
                                Visibility="Collapsed" />
                            <Button x:ConnectionId='7'
                                x:Name="LunchReportButton"
                                                                
                                Content="Print Lunch Report"
                                Style="{StaticResource ActionButtonStyle}"
                                Visibility="Collapsed" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:ConnectionId='3' x:Name="BusyRing" Width="18" Height="18" IsActive="False" />
                            <TextBlock x:ConnectionId='4' x:Name="BusyTextBlock" Opacity="0.7" Text="Ready" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <InfoBar x:ConnectionId='2'
                    x:Name="StatusInfoBar"
                    IsOpen="True"
                    IsClosable="False"
                    Title="Checkup"
                    Message="OK!"
                    Severity="Success" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

