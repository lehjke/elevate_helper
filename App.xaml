                                        VerticalAlignment="Bottom"
                                        Background="{ThemeResource IosSelectedIndicatorBrush}"
                                        CornerRadius="1.5"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
