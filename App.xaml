                    <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedUnfocused" Color="#1F0A84FF" />
                    <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedPressed" Color="#1F0A84FF" />
                    <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedPointerOver" Color="#1F0A84FF" />
